# Copy to .env (or set these in your host's settings).
PORT=4000
# postgres://user:pass@host:5432/db  — or leave unset to use an embedded PGlite database in ./.pglite
DATABASE_URL=postgres://guidepost:guidepost@localhost:5432/guidepost
# At least 32 random characters, e.g. `openssl rand -hex 32`. Required when NODE_ENV=production.
JWT_SECRET=
# Comma-separated dashboard origins allowed to call the API. Unset = allow all (development only).
CORS_ORIGINS=http://localhost:5173
