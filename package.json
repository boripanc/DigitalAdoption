{
  "name": "guidepost",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @guidepost/api",
    "dev:dashboard": "npm run dev -w @guidepost/dashboard",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node e2e/extension.e2e.mjs",
    "test:e2e:fiori": "node e2e/fiori.e2e.mjs",
    "fiori:serve": "cd e2e/fiori && ui5 serve --port 8766"
  },
  "devDependencies": {
    "@ui5/cli": "^4.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
